# .env.template — copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Process 1: Audit Report ────────────────────────────────────────────────────
# Controls the one-shot call that receives computed bias metrics and returns
# a structured narrative audit report.
#
# PROCESS1_API_KEY — the API key for this process (must be kept separate from
#                    the key used for Process 2).
# PROCESS1_MODEL   — the model identifier to use for report generation.
#                    Recommended default: gemini-2.5-flash
PROCESS1_API_KEY=
PROCESS1_MODEL=gemini-2.5-flash

# ── Process 2: Conversational Explainer ───────────────────────────────────────
# Controls the multi-turn streaming chat where users ask plain-English questions
# about their bias audit results.
#
# PROCESS2_API_KEY — the API key for this process (must be kept separate from
#                    the key used for Process 1).
# PROCESS2_MODEL   — the model identifier to use for the explainer chat.
#                    Recommended default: gemma-4-26b-a4b-it
PROCESS2_API_KEY=
PROCESS2_MODEL=gemma-4-26b-a4b-it

# ── Feature flags ──────────────────────────────────────────────────────────────
# Set either to false to disable that feature without removing its configuration.
ENABLE_AUDIT_REPORT=true
ENABLE_EXPLAINER_CHAT=true
